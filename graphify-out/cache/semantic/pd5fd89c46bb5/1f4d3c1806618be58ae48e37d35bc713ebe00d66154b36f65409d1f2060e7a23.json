{"nodes": [{"id": "docs_agentic_adr_adr_0001_stack_de_la_aplicacion_adr_0001", "label": "ADR-0001: Stack de la aplicacion", "file_type": "document", "source_file": "docs/agentic/ADR/ADR-0001-stack-de-la-aplicacion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MVP is mostly forms, listings and emails; Django solves it with least code and dependencies; maintained by Founder + agents, not a team."}, {"id": "docs_agentic_adr_adr_0001_stack_de_la_aplicacion_django_postgresql_option", "label": "Django 5.2 LTS + PostgreSQL server-rendered (chosen)", "file_type": "rationale", "source_file": "docs/agentic/ADR/ADR-0001-stack-de-la-aplicacion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built-in auth, ORM, migrations, validated forms, email, tests, management commands; single deploy; Python already used by Founder."}, {"id": "docs_agentic_adr_adr_0001_stack_de_la_aplicacion_nextjs_option", "label": "Next.js + PostgreSQL (rejected)", "file_type": "rationale", "source_file": "docs/agentic/ADR/ADR-0001-stack-de-la-aplicacion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auth/ORM/validation/email need separate libraries; framework changes often; scheduled tasks depend on hosting."}, {"id": "docs_agentic_adr_adr_0001_stack_de_la_aplicacion_baas_option", "label": "Backend as a service / Supabase (rejected)", "file_type": "rationale", "source_file": "docs/agentic/ADR/ADR-0001-stack-de-la-aplicacion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Business rules spread across DB policies and provider functions, harder to test; strong vendor lock-in."}, {"id": "docs_agentic_adr_adr_0001_stack_de_la_aplicacion_hosting_adr_pending", "label": "ADR de hosting (pendiente)", "file_type": "concep