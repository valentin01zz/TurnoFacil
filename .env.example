# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me
DEBUG=true
DB_NAME=turnofacil
DB_USER=turnofacil
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5433
# Production only (Render sets these; see docs/agentic/DEPLOYMENT.md):
# DATABASE_URL=postgresql://user:password@host:5432/turnofacil  (replaces the DB_* variables)
# ALLOWED_HOSTS=turnofacil.example
# CSRF_TRUSTED_ORIGINS=https://turnofacil.example
# SITE_URL=https://turnofacil.example
# SECURE_HSTS_SECONDS=3600
# Email. Defaults print emails to the console. Production uses Resend over SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=<Resend API key>
# DEFAULT_FROM_EMAIL=TurnoFacil <no-reply@turnofacil.example>
# Rate limits by IP: which X-Forwarded-For entry is the client (empty: the first; N: N-th from the right).
# CLIENT_IP_PROXY_COUNT=1
# Payments. Without these, plans are chosen online and paid by arrangement (manual provider).
# The scheduled job (cron) needs the same three values as the web service.
# PAYMENT_PROVIDER=billing.mercadopago.MercadoPagoProvider
# MERCADOPAGO_WEBHOOK_MAX_AGE_SECONDS=300  (0 turns off the signature age check)
# MERCADOPAGO_ACCESS_TOKEN=<access token from Mercado Pago Developers; test or production>
# MERCADOPAGO_WEBHOOK_SECRET=<webhook secret from Mercado Pago Developers>
# Manual bank transfer shown on the plans page (only if TRANSFER_ALIAS is set):
# TRANSFER_ALIAS=mi.alias.mp
# TRANSFER_HOLDER=Nombre Apellido
# TRANSFER_CUIT=20-12345678-9
# BILLING_CONTACT_EMAIL=pagos@turnofacil.example
